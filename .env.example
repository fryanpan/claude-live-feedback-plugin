# Environment for the claude-workspaces server.
#
# NOTHING HERE IS REQUIRED. Every key below is a seam that is OFF when unset:
# no key means the feature answers "not configured" in a way the UI renders as
# a settled state, never as an error. Copy what you need; the server reads the
# process environment, and each key also has a macOS Keychain entry it falls
# back to (the env var is the deliberate per-launch override — a `bun run
# staging` that should spend a different account sets it here rather than
# moving a Keychain item).
#
# DO NOT COMMIT A FILLED-IN COPY. This file is the example; a real one belongs
# outside the repo or in a gitignored `.env`.

# ---------------------------------------------------------------------------
# Live meetings — the browser-microphone path
# ---------------------------------------------------------------------------
# AssemblyAI Universal Streaming. Keychain: `assemblyai-api-key`.
# Unset → /audio/<docId> answers `unavailable: not_configured`.
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# Live meetings — the Recall.ai BOT path (Zoom / Google Meet / Teams)
# ---------------------------------------------------------------------------
# Recall.ai API key. Keychain: `claude-workspaces-recall-api-key`.
# Unset → the doc's "invite bot" row does not render at all.
CLAUDE_WORKSPACES_RECALL_API_KEY=

# Recall's REGION IS ITS HOSTNAME and a key is only valid in the region it was
# issued for — a key from the wrong one fails as a 401, so this must match the
# region the Recall dashboard shows. One of: us-east-1 (default), us-west-2,
# eu-central-1, ap-northeast-1.
RECALL_REGION=us-east-1

# The DEDICATED hostname Recall.ai's backend dials this deployment on — a
# first-level name such as `recall.example.com`, pointed at the same tunnel as
# everything else, with NO Cloudflare Access application in front of it.
#
# WHY A SECOND HOSTNAME. Recall's backend has no browser, so it cannot pass an
# Access challenge; on the operator's own hostname the bot callbacks had to be
# EXEMPTED from Access, which meant the address people open the product on had
# two unauthenticated holes in it. A hostname of its own costs a DNS record and
# a tunnel ingress rule, and in exchange the operator hostname has no
# exemptions at all while this one serves exactly two routes:
#
#   GET  wss://<host>/recall/<per-bot-token>   the realtime transcript socket
#   POST https://<host>/recall/status          the bot status webhook
#
# Each is open only while the credential it carries is configured (a Recall key
# for the first, RECALL_WEBHOOK_SECRET for the second); EVERY other path on
# this hostname answers 404, including the app, the API and the websocket for a
# real doc. The boot log prints the hostname, both URLs, and whether each one
# is armed.
#
# Unset is fine and is the fallback everything used before: callbacks are then
# derived from `CW_PUBLIC_BASE_URL` instead — but that hostname is Access-gated
# with no exemptions, so bots reach nothing. Set this if you want bots.
#
# Note there is deliberately no RECALL_PUBLIC_WS_BASE: the realtime endpoint is
# DERIVED (`recall.example.com` → `wss://recall.example.com/recall/<token>`),
# because two settings naming one host are two things to get wrong with no
# error when they disagree.
CW_RECALL_CALLBACK_HOST=

# Signing secret for Recall's bot status webhooks (Svix format, `whsec_...`),
# from the Recall dashboard. Recall publishes no static IPs to allowlist, so
# this is the only thing that proves a status webhook is really theirs. When
# set, an unsigned or badly signed webhook is refused; when unset the route
# falls back to the bot id being unguessable, which is weaker.
RECALL_WEBHOOK_SECRET=

# How long Recall keeps the recording, in hours. Minimum 1, default 24 — kept
# SHORT deliberately. The words this product keeps are in its own append-only
# transcript and are unaffected by this number.
RECALL_RETENTION_HOURS=24

# Transcribe each participant's own audio stream rather than the mixed room.
# ON (the default) is what makes the speaker on a turn the person who actually
# spoke, and it is the expensive setting: AssemblyAI bills per streaming
# session, so this opens one per speaking participant. Set to 0 for a single
# mixed session at a flat rate, with weaker attribution when people talk over
# each other.
RECALL_SEPARATE_STREAMS=1

# What the bot is called in the participant list.
RECALL_BOT_NAME=Meeting Assistant
