{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__navigate",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-preview-nav.ts"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_live-feedback_live-feedback__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-plugin-ops.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-plugin-ops.ts"
          }
        ]
      }
    ]
  }
}
