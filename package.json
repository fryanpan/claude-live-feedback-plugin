{
  "name": "claude-workspaces-plugin",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*", "demos/*"],
  "scripts": {
    "bootstrap": "bun run scripts/bootstrap.ts",
    "dev": "bun run scripts/serve.ts",
    "dev:bare": "bun run packages/server/src/bin.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun run test:vitest && bun run test:server",
    "test:vitest": "vitest run",
    "test:server": "bun test packages/server/test",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:widget": "bun run packages/widget/scripts/build.ts",
    "build:markdown-app": "bun run packages/markdown-app/scripts/build.ts",
    "build:mcp": "bun run packages/mcp/scripts/build.ts",
    "build:all": "bun run build:widget && bun run build:markdown-app && bun run build:mcp",
    "publish:mcp": "cd packages/mcp && npm publish",
    "check:build-id": "bun run scripts/check-build-id.ts",
    "check:widget-size": "bun run scripts/check-widget-size.ts",
    "check:plugin-version": "bun run scripts/check-plugin-version.ts",
    "check:scrub-gate": "python3 scripts/scrub-selftest.py",
    "staging": "bun run scripts/staging.ts",
    "share": "bun run scripts/share.ts",
    "activity:backfill": "bun run packages/server/src/activity-backfill.ts",
    "activity:repair-owner": "bun run packages/server/src/activity-repair-owner.ts",
    "identity:link": "bun run scripts/link-identity.ts",
    "review:migrate": "bun run packages/server/src/migrate-review-queue.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "happy-dom": "^20.8.9",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
