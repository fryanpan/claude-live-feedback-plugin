<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Socket-pool watcher (see scripts/socket-watch.sh). One CSV line a minute to
  ~/Library/Logs/socket-watch.csv, so the next ENOBUFS event names its holder.

  Install (replace __REPO__ with this checkout's absolute path):
    sed "s|__REPO__|$(pwd)|g" scripts/com.fryanpan.socket-watch.plist \
      > ~/Library/LaunchAgents/com.fryanpan.socket-watch.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.fryanpan.socket-watch.plist
  Check:   launchctl print gui/$(id -u)/com.fryanpan.socket-watch | grep state
  Remove:  launchctl bootout gui/$(id -u)/com.fryanpan.socket-watch
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fryanpan.socket-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/socket-watch.sh</string>
    <string>--watch</string>
  </array>
  <!-- 15s, not the script's 60s default: a measured burst (2,261 TIME_WAIT,
       5,371 mbufs, no suite running) rose and collapsed inside 40 seconds. -->
  <key>EnvironmentVariables</key>
  <dict><key>SOCKET_WATCH_INTERVAL</key><string>15</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/socket-watch.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/socket-watch.err.log</string>
</dict>
</plist>
