<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fryanpan.claude-workspaces</string>

    <key>WorkingDirectory</key>
    <string>{{REPO_DIR}}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{BUN_BIN}}</string>
        <string>run</string>
        <string>scripts/serve.ts</string>
        <!-- PROD: no hot-reload. A `bun --watch` reload once left the server
             alive-but-unbound and took the fleet-shared review server down. -->
        <string>--no-watch</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME_DIR}}</string>
        <key>PATH</key>
        <string>{{BUN_DIR}}:/usr/local/bin:/usr/bin:/bin</string>
        <!-- The external origin this deployment is reached on, when something
             in front terminates TLS (`tailscale serve` → this process on
             loopback). The server cannot discover it: from in here the socket
             is plain http. Left EMPTY the server falls back to
             `http://<discovered host>:<port>`, which is what it is directly
             reachable on and the correct answer with nothing in front.
             See docs/process/tailnet-https.md. -->
        <key>CW_PUBLIC_BASE_URL</key>
        <string>{{PUBLIC_BASE_URL}}</string>
        <!-- Link-mode sharing: the single public hostname the Cloudflare
             tunnel serves /s/<token> links on. Empty disables link mode.
             Baked in like the base URL above because the rename reinstall
             regenerated the plist without it and external sharing silently
             regressed — an env var only the old plist carried does not
             survive a template that never learned it. -->
        <key>CF_SHARE_PUBLIC_HOSTNAME</key>
        <string>{{SHARE_PUBLIC_HOSTNAME}}</string>
        <!-- The COLLABORATION hostnames: served through the tunnel, gated by
             a Cloudflare Access application over each one, and scoped to the
             share surface — not the privileged surface a tailnet name gets.
             All three of these travel together or none of them do: without
             CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD the server ignores the
             list and those hostnames answer 403 unknown_host, because a
             hostname with no Access application in front of it would be the
             API exposed to anyone who can reach the tunnel. Empty (the
             default) leaves the feature off. -->
        <key>CF_ACCESS_TUNNEL_HOSTS</key>
        <string>{{ACCESS_TUNNEL_HOSTS}}</string>
        <!-- The OPERATOR'S OWN public hostnames: served through the tunnel,
             gated by a Cloudflare Access application over each one, and then
             the WHOLE product — what loopback and the tailnet name get. A
             third list, kept apart from TRUSTED_HOSTS (LAN names, refused
             through the proxy) and from the collaboration list above (share
             surface only). Same all-or-none rule: without CF_ACCESS_TEAM_DOMAIN
             and CF_ACCESS_AUD the server ignores it and those hostnames
             answer 403 unknown_host. Empty (the default) leaves it off. -->
        <key>CW_PROXIED_TRUSTED_HOSTS</key>
        <string>{{PROXIED_TRUSTED_HOSTS}}</string>
        <!-- WHO the operator is, by the email Cloudflare Access verified. A
             token proves the Access policy admitted someone; one application
             may admit collaborators too, so this list is what makes the
             hostnames above the operator's door. Required with them (the
             server falls back to CW_OWNER_EMAIL, which this plist does not
             carry): empty, the host list is ignored. -->
        <key>CW_PROXIED_TRUSTED_EMAILS</key>
        <string>{{PROXIED_TRUSTED_EMAILS}}</string>
        <key>CF_ACCESS_TEAM_DOMAIN</key>
        <string>{{ACCESS_TEAM_DOMAIN}}</string>
        <key>CF_ACCESS_AUD</key>
        <string>{{ACCESS_AUD}}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/com.fryanpan.claude-workspaces.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/com.fryanpan.claude-workspaces.err.log</string>
</dict>
</plist>
